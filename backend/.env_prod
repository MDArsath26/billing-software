ENV=prod
DEBUG=False
SECRET_KEY=put-strong-secret-here

SITE_URL=https://yourdomain.com
PORT=8000
TIME_ZONE=Asia/Kolkata

ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourfrontend.com
CSRF_TRUSTED_ORIGINS=https://yourfrontend.com,https://yourdomain.com

# Mongo
MONGO_ENV=atlas
MONGO_ATLAS_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_EMAIL=
